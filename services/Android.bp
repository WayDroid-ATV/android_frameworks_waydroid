filegroup {
    name: "services.waydroid-sources",
    srcs: ["java/**/*.java"],
    path: "java",
    visibility: ["//frameworks/base/services"],
}

java_library_static {
    name: "services.waydroid",
    defaults: ["platform_service_defaults"],
    srcs: [":services.waydroid-sources"],
    libs: ["services.core"],
    static_libs: [
        "framework-waydroid.static",
    ],
}
