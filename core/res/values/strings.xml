<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Label for the WayDroid-ATV system components when they are shown to the user. -->
    <string name="waydroid_notification_channel">Waydroid warnings</string>

    <string name="waydroid_system_label">WayDroid-ATV System</string>

    <string name="broken_waydroid_integration_title">Waydroid integration is not functional</string>
    <string name="broken_waydroid_integration_msg">(Click this notification for more information) Things like "waydroid app install" will not work</string>
    <string name="broken_waydroid_integration_url">https://github.com/WayDroid-ATV/docs/wiki/%5BFAQ%5D-Waydroid-integration-support</string>

