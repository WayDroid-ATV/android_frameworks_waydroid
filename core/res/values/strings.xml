    <string name="dmabuf_missing_msg">DMA-BUF system heap does not exist (or not supported by the kernel), video playback might not work properly</string>
    <string name="dmabuf_missing_url">https://github.com/WayDroid-ATV/docs/wiki/%5BFAQ%5D-Video-playback#21-dma-buf-heap-support-in-kernel</string>

    <string name="unsupported_nvidia_kmd_title">Unsupported NVIDIA kernel driver detected</string>
    <string name="unsupported_nvidia_kmd_msg">Only the nouveau kernel driver is supported currently, consider switching to nouveau for proper GPU acceleration support</string>
    <string name="unsupported_nvidia_kmd_url">https://github.com/WayDroid-ATV/docs/wiki/%5BFAQ%5D-GPU-acceleration</string>

    <string name="sw_rendering_title">Waydroid is running without GPU acceleration</string>
    <string name="sw_rendering_msg">GPU acceleration support is either missing or explicitly disabled</string>
    <string name="sw_rendering_url">https://github.com/WayDroid-ATV/docs/wiki/%5BFAQ%5D-GPU-acceleration</string>
